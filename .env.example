# Copy to .env and fill in real values

# Database (SQLite)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Trust forwarded headers from the gateway/proxy (set to "true" behind Caddy/nginx)
AUTH_TRUST_HOST=true

# AI Provider Configuration (optional — defaults to z-ai-web-dev-sdk)
# Set these to use OpenRouter (e.g. GLM-4.5) instead of the built-in SDK.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=z-ai/glm-4.5
