NEXTAUTH_SECRET=GeGVqvx/Xn2Pri/Z2T5dxsPPtaxmPCJPmXdd34kflcA=

# Trust X-Forwarded-Host / X-Forwarded-Proto headers from the gateway (Caddy)
# so NextAuth derives the correct public URL (https://preview-chat-*.space-z.ai)
# instead of localhost:3000. Without this, the session cookie + callback
# redirect use localhost, causing "redirected you too many times" through the
# gateway. (NextAuth v4 uses this env var; the `trustHost` option is v5.)
AUTH_TRUST_HOST=true
